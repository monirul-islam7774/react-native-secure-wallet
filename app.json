{
  "expo": {
    "name": "Secure Wallet",
    "slug": "react-native-secure-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.monirul.securewallet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your wallet."
      }
    },
    "android": {
      "package": "dev.monirul.securewallet",
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "plugins": [
      ["expo-local-authentication", { "faceIDPermission": "Use Face ID to unlock your wallet." }],
      "expo-secure-store"
    ]
  }
}
